{
  "name": "cctv-express",
  "productName": "CCTV Express",
  "version": "0.2.19",
  "description": "Monitoramento de câmeras IP (CCTV) para Windows: ao vivo, gravação, reprodução, PTZ e luz.",
  "main": "src/main.js",
  "private": true,
  "author": "Stream.Builders",
  "scripts": {
    "postinstall": "node scripts/baixar-go2rtc.mjs && node scripts/copiar-three.mjs",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "builders.stream.cctvexpress",
    "productName": "CCTV Express",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/go2rtc.exe",
        "to": "go2rtc.exe"
      },
      {
        "from": "vendor/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "vendor/GO2RTC-LICENSE",
        "to": "GO2RTC-LICENSE"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "displayLanguageSelector": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "pt_BR",
        "es_ES",
        "fr_FR",
        "de_DE",
        "it_IT",
        "nl_NL",
        "pl_PL",
        "ru_RU",
        "sv_SE",
        "tr_TR",
        "vi_VN",
        "zh_CN",
        "ko_KR",
        "ja_JP",
        "id_ID",
        "ar_SA"
      ],
      "installerSidebar": "build/instalador-lateral.bmp",
      "uninstallerSidebar": "build/instalador-lateral.bmp",
      "installerHeader": "build/instalador-cabecalho.bmp"
    }
  },
  "allowScripts": {
    "electron@45.2.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "license": "MIT",
  "repository": "github:Stream-Builders/sb-cctv-express",
  "homepage": "https://cctvexpress.stream.builders"
}
